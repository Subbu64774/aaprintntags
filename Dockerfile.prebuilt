# ============================================
# Lightweight Dockerfile — uses PRE-BUILT artifacts
# (No Maven build, No npm build — runs fast on 1GB RAM VM)
# ============================================
FROM docker.io/eclipse-temurin:17-jre-alpine
WORKDIR /app

# Install nginx
RUN apk add --no-cache nginx wget

# Copy pre-built Spring Boot JAR
COPY target/aaprintntags-0.0.1-SNAPSHOT.jar app.jar

# Copy pre-built React frontend
COPY frontend/dist /usr/share/nginx/html

# Copy nginx config and startup script
COPY deploy/nginx.conf /etc/nginx/http.d/default.conf
COPY deploy/nginx-https.conf /etc/nginx/nginx-https.conf
COPY deploy/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Expose nginx ports (HTTP + HTTPS)
EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://localhost/api/health || exit 1

CMD ["/app/start.sh"]

