			"name": "💰 Payments",
			"item": [
				{ "name": "List Payments", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/payments?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["payments"], "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}] } } },
				{ "name": "Payments by Invoice", "request": { "method": "GET", "url": "{{baseUrl}}/payments/invoice/{{invoiceId}}" } },
				{ "name": "Invoice Balance", "request": { "method": "GET", "url": "{{baseUrl}}/payments/invoice/{{invoiceId}}/balance" } },
				{ "name": "Payments by Customer", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/payments/customer/{{customerId}}?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["payments","customer","{{customerId}}"], "query": [{"key":"page","value":"0"},{"key":"size","value":"20"}] } } },
				{
					"name": "Record Payment",
					"event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();","if (json.paymentId) { pm.collectionVariables.set('paymentId', json.paymentId); pm.test('Payment recorded', () => pm.expect(pm.response.code).to.eql(201)); }"] } }],
					"request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n    \"invoiceId\": {{invoiceId}},\n    \"paymentDate\": \"2026-03-17\",\n    \"amount\": 500.00,\n    \"paymentMode\": \"UPI\",\n    \"referenceNumber\": \"UTR{{$randomInt}}{{$randomInt}}\",\n    \"remarks\": \"Partial payment via UPI\"\n}" }, "url": "{{baseUrl}}/payments" }
				},
				{ "name": "Delete Payment", "request": { "method": "DELETE", "url": "{{baseUrl}}/payments/{{paymentId}}" } }
			]
		},
		{
			"name": "📊 Reports",
			"item": [
				{ "name": "Statement — All Customers", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/reports/customer-statement?from=2026-01-01&to=2026-12-31", "host": ["{{baseUrl}}"], "path": ["reports","customer-statement"], "query": [{"key":"from","value":"2026-01-01"},{"key":"to","value":"2026-12-31"}] } } },
				{ "name": "Statement — Specific Customer", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/reports/customer-statement?customerId={{customerId}}&from=2026-01-01&to=2026-12-31", "host": ["{{baseUrl}}"], "path": ["reports","customer-statement"], "query": [{"key":"customerId","value":"{{customerId}}"},{"key":"from","value":"2026-01-01"},{"key":"to","value":"2026-12-31"}] } } }
			]
		},
