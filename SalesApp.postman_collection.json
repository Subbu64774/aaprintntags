							"listen": "prerequest",
							"script": { "exec": ["// Fetch invoice context to get order-product IDs","const baseUrl = pm.collectionVariables.get('baseUrl');","const orderId = pm.collectionVariables.get('orderId');","const token = pm.collectionVariables.get('token');","","pm.sendRequest({","    url: baseUrl + '/invoices/context/order/' + orderId,","    method: 'GET',","    header: { 'Authorization': 'Bearer ' + token }","}, (err, res) => {","    if (!err && res.code === 200) {","        const ctx = res.json();","        const lines = (ctx.invoiceProductDTOList || []).map(l => ({","            orderProductId: l.orderProductId,","            productId: l.productId,","            quantity: l.quantity,","            price: l.price,","            size: l.size || '',","            description: l.description || '',","            hsnCode: l.hsnCode || '',","            selected: true","        }));","        pm.collectionVariables.set('_invoiceLines', JSON.stringify(lines));","    }","});"] }
